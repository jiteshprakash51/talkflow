{
  "name": "talkflow-api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "npx -y esbuild@0.24.2 src/index.ts src/local.ts --bundle --platform=node --format=esm --outdir=dist --external:ws --external:bufferutil --external:utf-8-validate --tsconfig=tsconfig.json --log-level=warning",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run build && node ./dist/local.js",
    "start": "node ./dist/local.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@libsql/client": "^0.18.0",
    "@talkflow/connectors": "0.1.0",
    "@talkflow/db": "0.1.0",
    "@talkflow/llm-router": "0.1.0",
    "@talkflow/prompts": "0.1.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
